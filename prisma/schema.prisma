// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model user {
  userId String @id @default(cuid())
  name String
  email String
  password String
  type String
  classrooms classroom[]
  enrolled enrolled[]
  chapter chapter[]
  quiz_attempts quiz_attempt[]
  viva_sessions viva_session[]
  learning_evidence learning_evidence[]
  concept_masteries student_concept_mastery[]
}

model classroom {
  classId String @id @default(cuid())
  className String
  ownerId String
  ownerUser user @relation(fields: [ownerId], references: [userId])
  enrolled enrolled[]
  chapter chapter[]
  quizzes quiz[]
  quiz_attempts quiz_attempt[]
  viva_sessions viva_session[]
  learning_concepts learning_concept[]
  learning_evidence learning_evidence[]
  concept_masteries student_concept_mastery[]
}

model enrolled {
  enrollId String @id @default(cuid())
  studId String
  classId String
  status String
  user user @relation(fields: [studId], references: [userId])
  classroom classroom @relation(fields: [classId], references: [classId])
}

model chapter {
  chapterId String @id @default(cuid())
  chapterName String
  classId String
  teacherId String
  classroom classroom @relation(fields: [classId], references: [classId])
  user user @relation(fields: [teacherId], references: [userId])
  content content[]
}

model content {
  fileId String @id @default(cuid())
  chapterId String
  fileName String
  fileUrl String
  fileType String
  classId String @default("Hello")
  chapter chapter @relation(fields: [chapterId], references: [chapterId])
}

model quiz {
  quizId String @id @default(cuid())
  classId String
  createdBy String
  title String
  topic String
  description String?
  instructions String?
  durationMinutes Int @default(30)
  totalMarks Int @default(0)
  passingMarks Int? @default(10)
  mode String @default("OPEN_NOW")
  startDate String?
  startTime String?
  endDate String?
  endTime String?
  published Boolean @default(false)
  releaseResultsMode String @default("IMMEDIATELY")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  classroom classroom @relation(fields: [classId], references: [classId])
  questions quiz_question[]
  attempts quiz_attempt[]
}

model quiz_question {
  questionId String @id @default(cuid())
  quizId String
  type String @default("MCQ")
  questionText String
  options String?
  correctAnswer String
  explanation String?
  marks Int @default(5)
  order Int @default(0)
  quiz quiz @relation(fields: [quizId], references: [quizId], onDelete: Cascade)
  answers quiz_answer[]
}

model quiz_attempt {
  attemptId String @id @default(cuid())
  quizId String
  studentId String
  classId String
  startedAt DateTime @default(now())
  expiresAt DateTime
  submittedAt DateTime?
  status String @default("IN_PROGRESS")
  score Int @default(0)
  totalMarks Int @default(0)
  percentage Int @default(0)
  resultPublishedAt DateTime?
  quiz quiz @relation(fields: [quizId], references: [quizId], onDelete: Cascade)
  user user @relation(fields: [studentId], references: [userId])
  classroom classroom @relation(fields: [classId], references: [classId])
  answers quiz_answer[]
}

model quiz_answer {
  answerId String @id @default(cuid())
  attemptId String
  questionId String
  studentAnswer String?
  marksAwarded Int?
  reviewStatus String @default("PENDING")
  feedback String?
  markedForReview Boolean @default(false)
  visited Boolean @default(true)
  savedAt DateTime @default(now())
  attempt quiz_attempt @relation(fields: [attemptId], references: [attemptId], onDelete: Cascade)
  question quiz_question @relation(fields: [questionId], references: [questionId], onDelete: Cascade)
}

model viva_session {
  id String @id @default(cuid())
  studentId String
  classId String
  topic String
  status String @default("IN_PROGRESS")
  overallScore Float?
  conceptualScore Float?
  correctnessScore Float?
  reasoningScore Float?
  communicationScore Float?
  deliveryFluencyScore Float?
  summary String?
  strengths String?
  weaknesses String?
  conceptMastery String?
  recommendedNextSteps String?
  isRetry Boolean @default(false)
  retryConcepts String?
  startedAt DateTime @default(now())
  completedAt DateTime?
  user user @relation(fields: [studentId], references: [userId])
  classroom classroom @relation(fields: [classId], references: [classId])
  questions viva_question[]
}

model viva_question {
  id String @id @default(cuid())
  sessionId String
  order Int
  concept String
  questionText String
  difficulty String @default("Medium")
  isFollowUp Boolean @default(false)
  parentQuestionId String?
  transcript String?
  score Float?
  correctness Float?
  completeness Float?
  reasoning Float?
  relevance Float?
  communication Float?
  deliveryFluency Float?
  misconceptionDetected Boolean @default(false)
  misconceptionSummary String?
  whatExplainedWell String?
  whatWasMissing String?
  conceptualFeedback String?
  nextAction String?
  askedAt DateTime @default(now())
  answeredAt DateTime?
  session viva_session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model learning_concept {
  conceptId String @id @default(cuid())
  classId String
  parentConceptId String?
  conceptName String
  category String @default("Core")
  order Int @default(0)
  createdAt DateTime @default(now())
  classroom classroom @relation(fields: [classId], references: [classId], onDelete: Cascade)
  evidence learning_evidence[]
  masteries student_concept_mastery[]
}

model learning_evidence {
  evidenceId String @id @default(cuid())
  studentId String
  classId String
  conceptId String?
  conceptName String
  sourceType String
  sourceRecordId String?
  sourceTitle String
  score Float
  maxScore Float @default(10)
  percentage Float
  confidence String @default("Medium")
  weight Float @default(1.0)
  summary String?
  weakness String?
  recommendation String?
  timestamp DateTime @default(now())
  user user @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  classroom classroom @relation(fields: [classId], references: [classId], onDelete: Cascade)
  concept learning_concept? @relation(fields: [conceptId], references: [conceptId])
}

model student_concept_mastery {
  masteryId String @id @default(cuid())
  studentId String
  classId String
  conceptId String?
  conceptName String
  masteryScore Float
  status String
  confidence String @default("Low")
  evidenceCount Int @default(0)
  primaryWeakness String?
  recommendedAction String?
  updatedAt DateTime @updatedAt
  user user @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  classroom classroom @relation(fields: [classId], references: [classId], onDelete: Cascade)
  concept learning_concept? @relation(fields: [conceptId], references: [conceptId])
}

model assignment_viva_request {
  requestId String @id @default(cuid())
  assignmentId String
  submissionId String
  studentId String
  classId String
  teacherId String
  status String @default("PENDING")
  vivaSessionId String?
  writtenScore Float?
  vivaScore Float?
  consistency String?
  insightSummary String?
  requestedAt DateTime @default(now())
  completedAt DateTime?
}